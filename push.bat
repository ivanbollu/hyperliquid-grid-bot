git init                                  # 把该文件夹初始化为 Git 仓库
git add .                                 # 把文件夹内所有文件加入暂存区
git commit -m "首次提交"                    # 生成第一个提交
git branch -M main                        # 把分支命名为 main
git remote add origin https://github.com/ivanbollu/hyperliquidperptrade.git
git push -u origin main